{
  "name": "mamba-widget",
  "version": "1.0.0",
  "description": "Cute daily focus with plant vibes",
  "author": "Mamba Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --config.win.target=zip",
    "package": "electron-packager . MambaWidget --platform=win32 --arch=x64 --icon=mamba.png --overwrite --out=dist",
    "postinstall": "node patch-sprintf.js"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "crypto-js": "^4.2.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^42.10.0",
    "electron-builder": "^26.5.0",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.12",
    "tar": "7.5.22",
    "builder-util-runtime": "9.7.0",
    "glob": "10.5.0",
    "rimraf": "5.0.10",
    "ejs": "4.0.1",
    "http-cache-semantics": "^4.3.0",
    "sprintf-js": "^1.1.3",
    "undici": "^8.11.2"
  },
  "build": {
    "appId": "com.mamba.widget",
    "productName": "MambaWidget",
    "win": {
      "target": "zip"
    }
  }
}
